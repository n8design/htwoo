{
  "name": "website",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "website",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run dev", "cwd": "website" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npm run build", "cwd": "website" },
      "outputs": ["{projectRoot}/site"]
    }
  },
  "tags": ["scope:website", "type:application"]
}
