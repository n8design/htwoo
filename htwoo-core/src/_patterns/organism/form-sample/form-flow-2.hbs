<section class="facility-form">
    <details class="hoo-accordion" open>
        <summary class="hoo-accordion-header">
            <div class="hoo-accordion-summary">
                {{> atoms-icon }}
                <h3>Reported issue{{text}}</h3>
            </div>
        </summary>
        <div>
            {{> molecules-new-disp-step1 }}

        </div>
    </details>
    <section class="review">
        <h2>Review and verify</h2>
        {{> molecules-new-form-step2 }}
    </section>
</section>
<script>
    (() => {
        // Get the current date and time
        const now = new Date();
        // Calculate the next time (one hour later)
        const nextTime = new Date(now.getTime() + 60 * 60 * 1000);

        // Insert a date into a <time> field, formatted based on the user's locale
        const setTime = (id, date) => {
            const time = document.getElementById(id);
            if (!time) return;
            time.setAttribute('datetime', date.toISOString());
            time.textContent = date.toLocaleString();
        };

        setTime('current-time', now);
        setTime('next-time', nextTime);
    })();
</script>