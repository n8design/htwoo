{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // For package distribution: compile src/ts to ES modules + declarations in lib/js,
    // which rollup then bundles into dist/js/{umd,cjs,amd}
    "allowJs": false,
    "rootDir": "./src/ts",
    "outDir": "../packages/htwoo-core/lib/js/",
    "tsBuildInfoFile": "../packages/htwoo-core/lib/.tsbuildinfo"
  },
  "include": ["src/ts/**/*.ts"],
  "exclude": []
}
